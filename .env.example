# Copiar a .env (ignorado por git). Ningun secreto va al repositorio.

# --- modelo ---
MODEL_PATH=model/model.joblib

# --- ASR (ver #6) ---
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
CPU_THREADS=4

# --- presupuesto de respuesta ---
# El limite duro del reto son 30 s; dejamos margen para serializar la respuesta.
DETECT_TIMEOUT_S=25

# --- opcional: transcripcion de la llamada en la interfaz (ElevenLabs), ver #10 ---
# Sin clave, /transcribe responde 503 y la interfaz muestra solo el veredicto. /detect no la usa.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TIMEOUT_S=60
# Duracion maxima que se manda a transcribir: ElevenLabs factura cada canal por separado.
TRANSCRIPCION_MAX_S=600

# --- durable audit / MongoDB Atlas ---
# Tambien se aceptan MONGODB_URI, MONGODB_DATABASE y MONGODB_COLLECTION, que prevalecen.
MONGO_URI=
AUDIT_ID_KEY=
MONGO_DB=altur_defense
COLLECTION_CALLS=calls
MONGODB_TIMEOUT_MS=5000
ENVIRONMENT=development
LOG_LEVEL=INFO
AUDIT_SPOOL_DIR=data/raw
# JSONL del auditor anterior; solo lo lee python -m src.migrate_audit
AUDIT_LOG_PATH=data/audit.jsonl
PROCESSED_DIR=data/processed
MODEL_VERSION=unknown
PIPELINE_VERSION=audit-v1
WORKER_POLL_SECONDS=2
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_SECONDS=1
WORKER_BATCH_SIZE=100
MAX_JSON_BYTES=1048576
# Banda de probabilidad en la que una llamada es incierta y deja su referencia.
AUDIT_BANDA_MIN=0.10
AUDIT_BANDA_MAX=0.90
# true: /detect responde 503 si no puede conservar la auditoria. Por defecto responde igual.
AUDIT_REQUIRED=false
